PROXMOX_URL=https://192.168.178.2:8006
PROXMOX_TOKEN_ID=sync@pve!sync-token
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

DOMAIN=myhome.net

DNS_MODE=standard

NPM_URL=http://192.168.178.164:81
NPM_IP=192.168.178.164
NPM_USER=admin@example.com
NPM_PASSWORD=changeme

PIHOLE_URL=http://192.168.178.10
# Leave empty if Pi-hole has no web password; app passwords require a web password
PIHOLE_PASSWORD=

ENABLE_SSL=true
# Use an existing NPM certificate (ID) for all hosts. 0 = request a new Let's Encrypt cert
NPM_CERTIFICATE_ID=6
# Probe backends and forward via https if they speak TLS (default true)
DETECT_SCHEME=true
DRY_RUN=false

LOG_LEVEL=INFO
